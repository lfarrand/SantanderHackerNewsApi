<Project>
  <PropertyGroup>
    <!-- Shared TargetFramework. Move this onto individual .csproj files if any project
         needs a different framework or multi-targeting. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Treating warnings as errors helps keep the build clean by forcing you to fix warnings in order to build, and also vastly reduces build output noise. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>

    <!-- .NET 10 already defaults these; being explicit documents intent. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>

    <!-- Keep audit and pruning diagnostics as warnings so TreatWarningsAsErrors
         does not fail the build on transitive advisories or pruned framework packages.
         Escalate these on CI if you want a hard gate. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904;NU1510</WarningsNotAsErrors>

    <!-- Reproducible restore. Commit each project's packages.lock.json.
         GitHub Actions sets CI=true; Azure Pipelines typically sets TF_BUILD. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true' or '$(TF_BUILD)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>
</Project>
