<Project>
    <!-- Do not inherit TargetFramework / TreatWarningsAsErrors from the repo root. -->
    <!-- Repo-level Directory.Build.props sets <TargetFramework>net10.0</TargetFramework> for every project. That is wrong for an .esproj -->
    <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.esproj'">
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    </PropertyGroup>
</Project>
