<Project>
    <!-- MSBuild automatically loads only the nearest Directory.Build.props. -->
    <!-- This file does not import the repo root props, keeping their TargetFramework and warning settings out of the .esproj. -->
    <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.esproj'">
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    </PropertyGroup>
</Project>
