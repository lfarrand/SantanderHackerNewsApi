<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Repo-root config: do not inherit user or machine package sources. -->
  <packageSources>
    <clear />
    <add key="nuget.org"
         value="https://api.nuget.org/v3/index.json"
         protocolVersion="3" />
  </packageSources>

  <!-- Require every package ID (including transitives) to come from a mapped source.
       Add prefix patterns here before introducing a second feed. -->
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <!-- Vulnerability data only. Safe to keep even if nuget.org later stops being a package source. -->
  <auditSources>
    <clear />
    <add key="nuget.org-audit" value="https://data.nuget.org/v3/index.json" />
  </auditSources>
</configuration>
